local function findNearestPrompt(root)
    local best, bestDist, bestPrompt = nil, math.huge, nil
    local rootPos = root.Position
    local function consider(obj)
        if not obj:IsA("ProximityPrompt") then return end
        local part = obj.Parent
        if part and part:IsA("BasePart") then
            local d = (rootPos - part.Position).Magnitude
            if d <= PROMPT_SCAN_RADIUS and d < bestDist then
                best = part bestDist = d bestPrompt = obj
            end
        end
    end
    for _, folderName in ipairs(SCAN_FOLDERS) do
        local folder = workspace:FindFirstChild(folderName)
        if folder then for _, desc in ipairs(folder:GetDescendants()) do consider(desc) end end
    end
    if not bestPrompt then
        for _, desc in ipairs(workspace:GetDescendants()) do consider(desc) end
    end
    return best, bestDist, bestPrompt
end

