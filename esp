local function randomKey()
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    local s = ""
    for i = 1, 25 do local r = math.random(1, #chars) s = s .. chars:sub(r, r) end
